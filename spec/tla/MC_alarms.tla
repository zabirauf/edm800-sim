------------------------------- MODULE MC_alarms -------------------------------
(* Model "alarms": the spec (EDMCore) model-checked, and the JavaScript implementation's observed graph            *)
(* (ImplGraph_alarms, generated by tools/tla-conformance.mjs) judged against it.                                  *)
EXTENDS EDMCore, ImplGraph_alarms

MCAlarmPri == <<"OILH", "BATL">>
MCItems == <<"FUEL", "RATE", "OATU", "EGT1", "HPQ", "KF", "ACCUM", "GPSC", "DUMP", "END">>
MCInputs == {"StepTap", "LfTap", "StepHold5", "BothHold5", "Timer", "TwoMin", "PowerOn", "PowerOff", "Raise", "Clear", "Expire", "Record", "OffEnds", "SnapEnds"}
MCFF == TRUE

Ids == DOMAIN ImplState
EvIds == DOMAIN EvList
Targets(i, e) == {ImplState[j] : j \in ImplNext[i][e]}

(* 1. every state the implementation reached is a well-formed spec state (normalisation, shown alarm, light) *)
BadStates == {i \in Ids : ImplState[i] # Fix(ImplState[i])}
(* 2. soundness: every implementation step is one the spec allows                                            *)
Forbidden == {p \in Ids \X EvIds : ~(Targets(p[1], p[2]) \subseteq Succ(ImplState[p[1]], EvList[p[2]]))}
(* 3. completeness: every step the spec allows from an explored state is one the implementation takes        *)
Missing == {p \in ImplExplored \X EvIds :
              /\ ~OutOfScope(ImplState[p[1]], EvList[p[2]])
              /\ ~(Succ(ImplState[p[1]], EvList[p[2]]) \subseteq Targets(p[1], p[2]))}

ASSUME {EvList[e] : e \in EvIds} = Events
ASSUME PrintT(<<"implementation", Len(ImplState), "states", Cardinality(ImplExplored), "explored">>)
ASSUME \A i \in BadStates : PrintT(<<"STATE NOT ALLOWED", ImplState[i], "spec form", Fix(ImplState[i])>>)
ASSUME \A p \in Forbidden : PrintT(<<"FORBIDDEN STEP", ImplState[p[1]], EvList[p[2]], "impl went to", Targets(p[1], p[2]),
                                       "spec allows", Succ(ImplState[p[1]], EvList[p[2]])>>)
ASSUME \A p \in Missing : PrintT(<<"MISSING STEP", ImplState[p[1]], EvList[p[2]], "impl went to", Targets(p[1], p[2]),
                                     "spec allows", Succ(ImplState[p[1]], EvList[p[2]])>>)
ASSUME PrintT(<<"bad states", Cardinality(BadStates), "forbidden steps", Cardinality(Forbidden), "missing steps", Cardinality(Missing)>>)
ASSUME BadStates = {} /\ Forbidden = {} /\ Missing = {}

(* 4. while model-checking the spec: every state the spec can reach, the implementation reached too           *)
ImplReached == {ImplState[i] : i \in Ids}
SpecStateImplemented == st \in ImplReached
=============================================================================
